# Template for local settings. Copy it to .env (gitignored) and adjust:
#   cp .env.example .env
# Validated at startup by src/config/env.validation.ts. Never put real secrets here.

# ---------- App ----------
NODE_ENV=development
APP_NAME=asset-service
PORT=3002
API_PREFIX=
API_VERSION=
# Comma-separated list of allowed frontend origins, e.g. http://localhost:5173
CORS_ORIGINS=
CORS_CREDENTIALS=true

# ---------- Database ----------
# Also read by docker-compose.yaml, so the container and the app use the same credentials.
# The app runs on the host, so it reaches the Postgres container through localhost.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_DATABASE=asset_service
# Keep false: the schema is managed by migrations (npm run migration:run).
# If true, the app creates tables on startup and migration:run then fails.
DATABASE_SYNCHRONIZE=false
DB_LOGGING=false
DATABASE_SSL=false
# Only set false for a server with a self-signed certificate: it disables
# certificate checks entirely.
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# ---------- Docs (Swagger) ----------
DOCS_ENABLED=true
DOCS_PATH=docs
DOCS_DESCRIPTION=
